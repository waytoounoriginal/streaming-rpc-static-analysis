{
  "schema_version": "grpc.session.v1",
  "protocol": {
    "package": "real_repos",
    "service": "FlightService",
    "method": "Handshake",
    "rpc_type": "BIDIRECTIONAL_STREAMING",
    "client_stream_type": "real_repos.HandshakeRequest",
    "server_stream_type": "real_repos.HandshakeResponse"
  },
  "states": {
    "S0_HANDSHAKE_OPEN": {
      "description": "Handshake open: Client writes HandshakeRequest or reads server challenge",
      "terminal": false,
      "transitions": [
        {
          "op": "Write",
          "target": "S0_HANDSHAKE_OPEN",
          "guard": null
        },
        {
          "op": "Read",
          "target": "S0_HANDSHAKE_OPEN",
          "guard": null
        },
        {
          "op": "WritesDone",
          "target": "S1_WRITES_DONE",
          "guard": null
        }
      ]
    },
    "S1_WRITES_DONE": {
      "description": "Client half-closed Handshake stream; MUST call Finish() before returning",
      "terminal": false,
      "transitions": [
        {
          "op": "Read",
          "target": "S1_WRITES_DONE",
          "guard": null
        },
        {
          "op": "Finish",
          "target": "S2_FINISHED",
          "guard": null
        }
      ]
    },
    "S2_FINISHED": {
      "description": "Terminal session state: Handshake stream finalized via Finish()",
      "terminal": true,
      "transitions": []
    }
  },
  "initial_state": "S0_HANDSHAKE_OPEN"
}
